# Not loaded automatically. Use shell variables, MCP env, or:
# node --env-file=.env dist/index.js doctor (Node 20.6+)
TYPESAFE_API_KEY=ts_...
# JEV_MCP_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# JEV_MCP_ALLOW_CUSTOM_BASE_URL=1
# JEV_MCP_MOCK=1
# JEV_MCP_TIMEOUT_MS=30000
# JEV_MCP_AUTO_ACCEPT=0.7
# JEV_MCP_REVIEW_AT=0.5
# JEV_MCP_PROFILE=balanced   (balanced 0.7, conservative 0.8 = the earlier default, strict 0.9)
# JEV_MCP_TRIAGE_RECOVERABLE_AT=0.7
# JEV_POLICY_FILE=C:\path\to\repo\.jev-policy.json
# JEV_MCP_BLOCK_AT=0.75
# JEV_MCP_LEDGER=1
# JEV_MCP_LEDGER_DIR=C:\Users\you\.jev-mcp
# JEV_MCP_LEDGER_MAX_BYTES=50000000
# JEV_MCP_CACHE_TTL_MS=0
# JEV_MCP_CACHE_MAX_ENTRIES=256
# JEV_MCP_TOKEN_BUDGET=
# Most chunks one review sends when a diff is too large for a single request (default 12)
# JEV_MCP_MAX_REVIEW_CHUNKS=
# Claude Code hooks (see docs/hooks.md): enforce (default), shadow (record only) or off
# JEV_MCP_HOOKS=
# Pull-request gate deadline in milliseconds (default 600000)
# JEV_MCP_CI_DEADLINE_MS=
# Show the judge where changed symbols are used elsewhere (opt-in; see docs/ci.md)
# JEV_MCP_CALLER_CONTEXT=
# JEV_MCP_HOOK_DEADLINE_MS=20000
# JEV_MCP_HOOK_MAX_CALLS=200
# Stop hook: a test command run for evidence (from the environment only)
# JEV_MCP_TEST_COMMAND=
