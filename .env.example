# Not loaded automatically. Use shell variables, MCP env, or:
# node --env-file=.env dist/index.js doctor (Node 20.6+)
TYPESAFE_API_KEY=ts_...
# JEV_MCP_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# JEV_MCP_ALLOW_CUSTOM_BASE_URL=1
# JEV_MCP_MOCK=1
# JEV_MCP_TIMEOUT_MS=30000
# JEV_MCP_AUTO_ACCEPT=0.8
# JEV_MCP_REVIEW_AT=0.5
# JEV_MCP_PROFILE=balanced
# JEV_MCP_TRIAGE_RECOVERABLE_AT=0.8
# JEV_POLICY_FILE=C:\path\to\repo\.jev-policy.json
# JEV_MCP_BLOCK_AT=0.75
# JEV_MCP_LEDGER=1
# JEV_MCP_LEDGER_DIR=C:\Users\you\.jev-mcp
# JEV_MCP_LEDGER_MAX_BYTES=50000000
# JEV_MCP_CACHE_TTL_MS=0
# JEV_MCP_CACHE_MAX_ENTRIES=256
# JEV_MCP_TOKEN_BUDGET=
# Most chunks one review sends when a diff is too large for a single request (default 12)
# JEV_MCP_MAX_REVIEW_CHUNKS=
