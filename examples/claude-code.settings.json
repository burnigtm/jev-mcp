{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "/path/to/jev-mcp/dist/index.js",
              "hook",
              "pre-tool-use"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "/path/to/jev-mcp/dist/index.js",
              "hook",
              "stop"
            ],
            "timeout": 120
          }
        ]
      }
    ]
  }
}
